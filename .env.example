GOOGLE_CLOUD_PROJECT=<your-project-id>

# --- Backend Configurations ---
BACKEND_PORT=8000
BACKEND_URL=

# --- Backend (web/backend/internal/config) ---
SERVER_LISTEN=:8000
SERVER_DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
SERVER_LOG_LEVEL=info
SERVER_ENVIRONMENT=dev
SERVER_JWT_SECRET=
SERVER_ACCESS_TTL=15m
SERVER_REFRESH_TTL=168h

# --- Tracker (docker compose --profile tracker up) ---
# MJPEG stream from the OV7670 camera node (firmware/camera). Docker on macOS can't reach the laptop webcam;
# for that, run `cd tracker && MQTT_HOST=localhost uv run track.py` on the host instead.
TRACKER_SOURCE=http://<esp32-cam-ip>:81/stream
TRACKER_MQTT_TOPIC=gimbal/target

# ----- Hardware (run `make firmware-secrets` after editing) -----
WIFI_SSID=
WIFI_PASSWORD=

# MQTT broker the ESP32s connect to (VM public IP or hostname).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
